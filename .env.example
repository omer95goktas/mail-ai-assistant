# =====================================================================
#  Yapay Zekâ E-posta Asistanı — Ayar Dosyası
#  Bu dosyayı ".env" adıyla kopyalayın ve değerleri kendinize göre doldurun:
#      cp .env.example .env
#  Değerleri tırnak içinde yazın. Bu dosyayı (.env) asla kimseyle paylaşmayın.
# =====================================================================

# ---------------------------------------------------------------------
# 1) ZORUNLU AYARLAR
# ---------------------------------------------------------------------

# Telegram'da @BotFather ile oluşturduğunuz botun anahtarı (token)
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRstuVWXyz"

# Sizin Telegram kullanıcı numaranız (bot yalnızca bu kişiye yanıt verir).
# Öğrenmek için Telegram'da @userinfobot'a "merhaba" yazın.
TELEGRAM_ADMIN_CHAT_ID="123456789"

# Google AI Studio'dan alacağınız Gemini API anahtarı: https://aistudio.google.com/apikey
GEMINI_API_KEY="BURAYA_GEMINI_API_ANAHTARINIZI_YAZIN"

# Kullanılacak Gemini modeli (hızlı ve ekonomik varsayılan önerilir)
GEMINI_MODEL="gemini-3.1-flash-lite"

# ---------------------------------------------------------------------
# 2) KİMLİK AYARLARI (asistan sizin adınıza nasıl konuşacak?)
# ---------------------------------------------------------------------

# Adınız soyadınız
OWNER_FULL_NAME="Ayşe Yılmaz"

# Asistanın sizden bahsederken kullanacağı hitap
OWNER_ADDRESS="Ayşe Hanım"

# Hitabın iyelik hali (Türkçe ek kuralı nedeniyle elle yazılır).
# Örnekler: "Ayşe Hanım'ın", "Mehmet Bey'in", "Dr. Can'ın", "Elif Öğretmen'in"
OWNER_ADDRESS_POSSESSIVE="Ayşe Hanım'ın"

# Giden e-postalarda "Kimden" alanında görünecek ad
MAIL_FROM_NAME="Ayşe Yılmaz"

# İmzada asistanın görünen adı
ASSISTANT_SIGNATURE_NAME="Gemini (Ayşe Yılmaz Asistanı)"

# İmzanın altına eklenecek web adresiniz (istemiyorsanız boş bırakın)
SIGNATURE_URL=""

# Her yanıtta yer alacak şeffaflık notu. Boş bırakırsanız şu metin kullanılır:
# "Bu yanıt Ayşe Hanım'ın kontrolü ve onayı doğrultusunda hazırlanmıştır. Sistemdeki her işlem
#  Ayşe Hanım'ın denetimindedir ve gerekli durumlarda kendisi doğrudan iletişime geçecektir."
# TRANSPARENCY_NOTE=""

# ---------------------------------------------------------------------
# 3) ÇALIŞMA AYARLARI
# ---------------------------------------------------------------------

# Gelen kutusunun kaç saniyede bir kontrol edileceği (30 önerilir, 20'nin altına inmeyin)
CHECK_INTERVAL="30"

# Veritabanı dosyası (boş bırakılırsa proje klasöründeki data/assistant.db kullanılır)
# DB_PATH="/opt/mail_assistant/data/assistant.db"

# systemd servis adı (kurulum betiği bu adı kullanır)
SERVICE_NAME="mailagent.service"

# ---------------------------------------------------------------------
# 4) UYGULAMA KATALOĞU (İSTEĞE BAĞLI)
#    Uygulama/ürün geliştiriyorsanız ve "indirme linki nedir?" gibi e-postalara
#    otomatik yanıt verilmesini istiyorsanız doldurun. Aksi halde boş bırakın.
# ---------------------------------------------------------------------

# Basit yöntem: JSON dosyası (örnek için catalog.example.json dosyasına bakın)
CATALOG_JSON_PATH=""

# Katalog / ürün web siteniz (varsa)
CATALOG_SITE_URL=""

# ---------------------------------------------------------------------
# 5) FİLTRELER (bu adreslerden gelenler kişisel e-posta sayılmaz)
# ---------------------------------------------------------------------
IGNORED_DOMAINS="googlegroups.com,yahoogroups.com,groups.io"
IGNORED_SENDERS="noreply,no-reply,donotreply,do-not-reply,mailer-daemon,postmaster"

# ---------------------------------------------------------------------
# 6) GELİŞTİRİCİ VE HAKKINDA BİLGİSİ (İSTEĞE BAĞLI)
#    /hakkinda komutu ve bilgi ekranında görünen buton ve bağlantılar.
# ---------------------------------------------------------------------
DEV_NAME="Ömer Göktaş"
DEV_WEBSITE="https://omergoktas.net"
DEV_SHOWCASE="https://apps.omergoktas.net"
DEV_EMAIL="mail@omergoktas.net"
