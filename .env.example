# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"
TELEGRAM_ADMIN_CHAT_ID="YOUR_TELEGRAM_ADMIN_CHAT_ID"

# Google Gemini API
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
GEMINI_MODEL="gemini-3.5-flash"

# Database & Intervals
DB_PATH="/opt/mail_assistant/data/assistant.db"
CHECK_INTERVAL="60"

# Showcase Website Integration (apps.omergoktas.net)
APPS_DB_PATH="/var/www/apps.omergoktas.net/data/apps.sqlite"
SHOWCASE_BASE_URL="https://apps.omergoktas.net"

# Ignore Filters (Mailing lists, bots, notifications)
IGNORED_DOMAINS="googlegroups.com,yahoogroups.com"
IGNORED_SENDERS="noreply,no-reply,donotreply,do-not-reply,mailer-daemon,postmaster"