[Unit]
Description=Yapay Zeka E-posta Asistani (Telegram + Gemini)
After=network-online.target
Wants=network-online.target
# Kaç kez çökerse çöksün yeniden başlatmaktan vazgeçme
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
WorkingDirectory=__APP_DIR__
ExecStart=__APP_DIR__/venv/bin/python3 -u __APP_DIR__/main.py
Restart=always
RestartSec=10s
EnvironmentFile=__APP_DIR__/.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONIOENCODING=utf-8
TimeoutStopSec=30
KillMode=mixed
MemoryMax=600M
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
